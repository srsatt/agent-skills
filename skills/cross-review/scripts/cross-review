#!/usr/bin/env bash
# Review changes with the other agent harness (a different model family) in a fresh context, as that harness's own reviewer role.
# usage: cross-review <codex|claude> <--uncommitted | --commit SHA | BASE_REF>   (the requirement text is read from stdin)
# Environment such as CODEX_HOME is inherited, so callers choose the account.
set -euo pipefail

die() {
  echo "cross-review: $1" >&2
  exit "${2:-1}"
}

[ -z "${CROSS_REVIEW_ACTIVE:-}" ] || die "nested cross-review refused" 2
export CROSS_REVIEW_ACTIVE=1

usage="usage: cross-review <codex|claude> <--uncommitted | --commit SHA | BASE_REF> < requirement"
[ "$#" -ge 2 ] || die "$usage" 2
other="$1"
case "$other" in
  codex | claude) ;;
  *) die "the harness must be codex or claude" 2 ;;
esac

case "$2" in
  --uncommitted)
    [ "$#" -eq 2 ] || die "$usage" 2
    target="the uncommitted changes (staged, unstaged, and untracked files): run \`git status --short\`, \`git diff HEAD\`, and read the untracked files"
    ;;
  --commit)
    [ "$#" -eq 3 ] || die "$usage" 2
    git rev-parse --verify --quiet "$3^{commit}" >/dev/null || die "unknown commit: $3" 2
    target="the commit $3: run \`git show $3\`"
    ;;
  -*) die "$usage" 2 ;;
  *)
    [ "$#" -eq 2 ] || die "$usage" 2
    git rev-parse --verify --quiet "$2^{commit}" >/dev/null || die "unknown base ref: $2" 2
    target="the changes from $2 to HEAD: run \`git diff $2...HEAD\`"
    ;;
esac

requirement="$(cat)"
[ -n "$requirement" ] || die "the requirement text is empty; pass it on stdin" 2

prompt="Review $target. Judge the changes only against this requirement:

$requirement

Complete this review yourself in this session. Do not delegate it and do not run cross-review. Read surrounding code when you need it. Do not modify files. Report each finding with file:line, a concrete failure scenario, and a fix. Drop speculative points. If nothing survived, say so."

if [ -n "${CROSS_REVIEW_DRY:-}" ]; then
  printf 'cross-review %s\n%s\n' "$other" "$prompt"
  exit 0
fi

command -v "$other" >/dev/null 2>&1 || die "$other is not installed" 127

# The reviewer role comes from the other harness's own configuration: ~/.claude/agents/reviewer.md or $CODEX_HOME/reviewer.config.toml.
if [ "$other" = claude ]; then
  printf '%s' "$prompt" | claude -p \
    --agent reviewer \
    --strict-mcp-config \
    --max-turns "${CROSS_REVIEW_MAX_TURNS:-30}" \
    --allowed-tools "Read Grep Glob Bash(git status:*) Bash(git diff:*) Bash(git show:*) Bash(git log:*)"
else
  printf '%s' "$prompt" | codex exec -p reviewer -s read-only --ephemeral -
fi
